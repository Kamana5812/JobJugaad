# Optional locally; Render supplies the managed PostgreSQL connection string.
DATABASE_URL=
# Reserved for Phase 1 authentication. Never commit a real secret.
JWT_SECRET=

# Explicit existing accounts only, configured on the server; no passwords here.
# Example JSON: [{"email":"admin@example.test","college_id":1}]
ADMIN_ACCOUNTS=[]

# Gmail HTTPS API: grant only gmail.send; enter real values in Render, never in git/chat.
MAIL_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Explicit opt-ins for LOCAL legacy regression testing only; production defaults are closed.
ALLOW_DEMO_SIGNUPS=no
SEED_DEMO_DATA=no
