# Optional locally; Render supplies the managed PostgreSQL connection string.
DATABASE_URL=
# Reserved for Phase 1 authentication. Never commit a real secret.
JWT_SECRET=

# Explicit existing accounts only, configured on the server; no passwords here.
# Example JSON: [{"email":"admin@example.test","college_id":1}]
ADMIN_ACCOUNTS=[]

# Resend HTTPS API. Real keys belong only in Render, never in git/chat/frontend.
RESEND_API_KEY=
# Production: an address on your Resend-verified domain. Never a Gmail address.
MAIL_FROM=
# Only for MAIL_FROM=onboarding@resend.dev; must match your Resend account email.
# Other recipients cannot activate until a verified production sender is configured.
RESEND_TEST_RECIPIENT=
# Explicit opt-ins for LOCAL legacy regression testing only; production defaults are closed.
ALLOW_DEMO_SIGNUPS=no
SEED_DEMO_DATA=no
