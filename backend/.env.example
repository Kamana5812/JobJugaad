# Optional locally; Render supplies the managed PostgreSQL connection string.
DATABASE_URL=
# Reserved for Phase 1 authentication. Never commit a real secret.
JWT_SECRET=

# Explicit existing accounts only, configured on the server; no passwords here.
# Example JSON: [{"email":"admin@example.test","college_id":1}]
ADMIN_ACCOUNTS=[]

# Select exactly one HTTPS transport: resend (existing default) or gmail (no bought domain).
EMAIL_PROVIDER=resend
# Gmail: same mailbox authorized by the owner; Resend: verified domain or restricted test sender.
MAIL_FROM=
# Gmail API send-only owner OAuth credentials. Set privately in Render, never in git/chat/frontend.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Resend values are used ONLY when EMAIL_PROVIDER=resend; there is no provider fallback.
RESEND_API_KEY=
# Only for MAIL_FROM=onboarding@resend.dev; must match your Resend account email.
RESEND_TEST_RECIPIENT=
# Explicit opt-ins for LOCAL legacy regression testing only; production defaults are closed.
ALLOW_DEMO_SIGNUPS=no
SEED_DEMO_DATA=no
